<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{DED39B0D-853B-169C-3780-F7E95A40E5E9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Zweite Audienz beim Negus</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{54565F75-E07E-94E7-6CCE-44EE23AB8DC9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Amr bin As versuchte es am nächsten Tag erneut und sagte zu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Najashi</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, er solle die Muslime über Jesus fragen. Sie würden schlimmes über ihn sagen.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Auch dieses Mal wiederholte </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ja´far</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> seine Aussagen, dass Jesus Diener und Prophet Allahs sei.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er erwähnte bzgl. Jesus die positiven Sachen und war nicht konfrontativ.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Bischöfe waren unzufrieden mit der Haltung </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Najashis</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> und er war ihnen nicht orthodox genug.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Um ein Anführer zu sein, braucht man eine gewisse Weisheit und politische Fähigkeiten. Man braucht Sprachgewandtheit. Deswegen Jafar bin Abi Talib. </a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="177497554"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>