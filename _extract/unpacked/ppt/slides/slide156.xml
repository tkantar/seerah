<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{003F1B8E-5907-CD1C-20BD-563531D5AA8C}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Juden in Madina &amp; </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Surah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Kahf</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{D1681797-E1D1-20C6-BC61-8363C6F60DA9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1103312" y="2052918"/><a:ext cx="9404723" cy="4195481"/></a:xfrm></p:spPr><p:txBody><a:bodyPr><a:normAutofit fontScale="92500" lnSpcReduction="10000"/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mushrikun</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> waren selber nicht schriftkundig und schickten Leute nach Madina zu jüdischen Gelehrten, um Beweise gegen die Prophetie Muhammads zu finden.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die jüdischen Gelehrten sagten sinngemäß:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Stellt ihm diese Fragen. Wenn er sie beantworten kann, ist er ein Prophet.</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Wenn nicht, ist er es nicht.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Sie nannten drei Prüfungsfragen:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Fragt ihn nach den jungen Männern, die in alter Zeit ihren Glauben bewahrten</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>und lange schliefen.</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>→ </a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0"/><a:t>Die Leute der Höhle (</a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0" err="1"/><a:t>Ashab</a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0"/><a:t> al-</a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0" err="1"/><a:t>Kahf</a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0"/><a:t>)</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Fragt ihn nach einem mächtigen Herrscher, der die Enden der Erde bereiste.</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>→ </a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0" err="1"/><a:t>Dhu</a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0"/><a:t> l-</a:t></a:r><a:r><a:rPr lang="de-DE" i="1" dirty="0" err="1"/><a:t>Qarnayn</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Fragt ihn nach dem Geist (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ruuh</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>).</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="508309756"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>