<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{DEA0A7CF-AFF2-8418-9104-7E04B169BD43}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Ehe mit Khadija</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{8FA7F0CD-1E6A-C05A-3854-8477DDC53302}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit fontScale="92500" lnSpcReduction="10000"/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Gesandte war bekannt für seine Ehrlichkeit und Gerechtigkeit im Handel, Er wurde als Al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Amiin</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bekannt.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er arbeitete für Khadija und ging auf Geschäftsreisen (Syrien).</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Khadija war eine zweifach geschiedene und reiche Frau</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>viel geerbt vom Vater und Ex-Mann, weil dieser niemanden hatte </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Sie sandte Ihm einen Brief als Heiratsantrag</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Alter der beiden: 25 (Muhammad), 40 (Khadija) (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>kathir</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>bayhaqi</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>)</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>(oder 28? (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ishaq</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>), macht mehr Sinn wegen 6 Kinder)</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Mahr: 500 </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>dirham</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> oder 20 Kamele.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Keine Ehe mit einer anderen Frau bis zu Ihrem Tod.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als Ali </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. 4 Jahre alt war, nahm der Prophet Ihn in seine Obhut.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1201661951"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>