<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{C119E485-48D3-3F4C-EB16-470CF5E62B5C}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hilful-Fuduul</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> (2)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{89CD1FFF-8FFB-F145-F829-E70CBEFE502B}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith von Aisha (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Muslim):</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Ich sagte: „O Gesandter Allahs, Abdullah bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Judan</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> pflegte in der Zeit der </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahiliyya</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> die Verwandtschaftsbande und speiste die Armen.</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Wird ihm das nützen?“</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er antwortete: </a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Nein. Denn er sagte an keinem Tag:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>‚Mein Herr, vergib mir meine Sünde am Tag des Gerichts.‘“</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="ar-SA" dirty="0"/><a:t>رَبِّ اغْفِرْ لِي خَطِيئَتِي يَوْمَ الدِّينِ</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Es reicht nicht, gut zu anderen zu sein. Es ist wichtiger, Allah zu akzeptieren und an Ihn zu glauben, als nett zu anderen zu sein.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Auch ein Mann, dessen Tochter zu Unrecht genommen wurde, hat Hilfe von </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hilful</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Fudul</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> beantragt und erhalten.</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1558138242"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>