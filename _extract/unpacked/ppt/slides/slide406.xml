<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A3B72AAC-02EC-78C7-C2BA-5948FE1E851E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Keine </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> nach der Eroberung</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{7F7DB99C-9411-119F-5B1A-B279EFA8AFE7}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Bukhari): „Es gibt keine Hidschra nach der Eroberung mehr, sondern weiterhin Jihad und Absicht. Und wenn ihr zum Ausrücken aufgerufen werdet, dann rückt aus.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die eigentliche </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> ist somit beendet. </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Verpflichtend ist sie weiterhin nur für Unterdrückte.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith bei Ibn Hibban in seinem </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Fudayk</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> kam zum Propheten und sagte:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Die Menschen behaupten, dass derjenige zugrunde geht, der nicht auswandert.“</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet antwortete: </a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Fudayk</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, verrichte das Gebet, entrichte die Zakah, meide das Schlechte und lebe im Gebiet deines Volkes, wo du möchtest.“</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="633572850"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>