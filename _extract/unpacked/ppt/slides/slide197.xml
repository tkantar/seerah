p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Viele Frauen und Kinder hörten zu.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quraisch</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> beschwerten sich.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quraisch</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sagten zu Ibn ad-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Daghinnah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Sag ihm, er soll seinen Herrn in seinem Haus anbeten.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu Bakr sagte schließlich:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Ich gebe dir deinen Schutz zurück und bin zufrieden mit dem Schutz Allahs.“</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1284269122"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>