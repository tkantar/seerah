<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{87FB7AF5-A989-1E63-8BC4-9C21DE86B308}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Walid bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mughira</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> (6)</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Offenbarung gegen ihn</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{7D539967-5AB2-51B5-A204-055C076D15A7}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Allah sandte </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Surah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mudatthir</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> 11-26 gegen Walid bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mughira</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>11. Lass Mich (allein) mit dem, den Ich erschaffen habe,</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>12. dem Ich reichlich Besitz gegeben habe,</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>13. und Söhne, die an seiner Seite stehen,</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>14. und dem Ich (die weltlichen) Annehmlichkeiten geebnet habe.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>15. (Und jetzt) wünscht er, dass Ich (ihm) noch mehr gebe.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>16. Nein, denn er hat sich (wiederholt) Unseren Zeichen widersetzt.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>17. Ich werde ihn (bald) einer </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>grossen</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Beschwerlichkeit aussetzen.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1157609322"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>