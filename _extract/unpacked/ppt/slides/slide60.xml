<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A225A43F-E97F-FF2A-8FC7-574290C62D9C}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Zayd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Haritha</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> (4)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{C34CAECC-8C9A-0AB5-716D-F1CE4152ABDC}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit lnSpcReduction="10000"/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er war einer der ersten, die den Islam annahmen. </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Zur </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahiliyya</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Zeit heiratete </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Zayd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Umm</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Ayman (die Dienerin von Amina). </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Sie hatten auch ein Kind zusammen Osama bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Zayd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, er ist im Haus des Propheten geboren. </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Wenn die Sahaba etwas vom Propheten wollten, gingen sie zu Osama und fragten ihn, ob er nicht für sie den Propheten fragen könnte, weil sie wussten, dass der Prophet ihn sehr liebte.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Osama wurde mal mit 16 Kommandant der islamischen Armee!</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Da </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Zayd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> nun ein freier Mann war, schlug der Prophet ihm die Ehe mit seiner Cousine </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Zaynab</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>bint</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahsch</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> vor, um von ihm alle Spuren der </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sklavenschaft</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> zu entfernen. Er heiratete mehrere </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quraisch</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Frauen später. </a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1449467707"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>