<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{E67CF5E1-79DF-F964-6CC1-9EFBE3E29172}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Exkurs: </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijrah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>-Kalender (3)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{99A233DD-5AAE-FC91-1C3E-EAC53F2F9399}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijrah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Kalender wurde nicht zur Zeit des Propheten </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>saw</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. Eingeführt, sondern erst von Umar </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Khattab im Jahre 17 (oder 16 oder 18).</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Anlässe:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Besonders bekannt ist der Brief von Abu Musa al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ash´ari</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, dem Statthalter in Basra: Von Umar kämen Schreiben, die beispielsweise mit „</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Scha´ban</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>“ datiert seien, ohne dass klar sei, ob der vergangene oder der kommende </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Schaʿban</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> gemeint sei. </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Daneben wird ein Rechtsfall über eine Schuldurkunde erwähnt, deren Fälligkeit auf einen Monat festgelegt war, aber ohne Jahresangabe.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1725517436"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>