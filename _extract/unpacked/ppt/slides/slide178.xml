<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F28A0A68-EC57-387F-2056-86303BA27A65}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> stört Gebet</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{AE4818CE-0119-EBA6-A6C7-805B85CA4F92}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit fontScale="92500" lnSpcReduction="10000"/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> fühlte sich durch das öffentliche Beten des Propheten </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>saw</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. provoziert und schwor (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Muslim):</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Bei al-Lat und al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ʿUzza</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>,</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Wenn ich Muhammad wieder in </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sajda</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sehe, werde ich meinen Fuß auf seinen Nacken setzen und Sand auf ihn werfen.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet betete, Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> ging auf ihn zu.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>plötzlich blieb er stehen, wich zurück und wirkte verängstigt</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Leute fragten: „Was ist los mit dir?“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> antwortete: „Zwischen mir und ihm war ein Graben aus Feuer</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>und schreckliche Gestalten.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet sagte: „Das waren Engel. Hätte er sich mir genähert,</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>hätten sie ihn Stück für Stück zerrissen.“</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:pPr lvl="1"/><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="880105710"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>