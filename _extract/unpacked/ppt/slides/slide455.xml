<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{C6C82164-A4FE-D1C9-9112-68BFF8615F5A}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Verbrüderung (5)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{B696AE6F-E8B0-9E7E-5FC5-1FF689EBFE6E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Muhajirun</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sagten, Sie hätten noch kein Volk gesehen, das bei Wohlstand großzügiger und bei Knappheit hilfsbereiter sei. </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Ansar hätten ihnen Arbeit abgenommen und sie am Ertrag beteiligt; daher fürchteten sie, die Ansar könnten den gesamten Lohn erhalten. </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet antwortete, dies sei nicht so, solange die </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Muhajirun</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> für sie </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Duʿa</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> machten und ihnen dankten beziehungsweise sie lobten. </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Verbrüderung war nicht nur am Anfang nach der </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijrah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, sondern fand auch Jahre später statt.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Z.B. Salman al-Farisi und Abu ad-Darda</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Entsprechend ist es </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sunnah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>vorallem</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Konvertieten</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, aber auch allgemein neue Leute zu verbrüdern und somit das muslimische Netzwerk zu stärken.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3718175527"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>