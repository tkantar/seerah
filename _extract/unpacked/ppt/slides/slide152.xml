<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{662C4CEF-5780-239D-71AD-FEEA7D365665}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Utba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rabia´s</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Frage</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{D234B5B4-DF3C-DDF2-E7C9-0C0AC52FB6BF}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1103312" y="1472242"/><a:ext cx="8946541" cy="4776157"/></a:xfrm></p:spPr><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Utba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Rabia, einer der einflussreichen Männer der </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quraisch</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, fragte den Propheten provokant und sauer:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Hältst du dich für besser als </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Abdulmuttalib</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>?“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Diese Frage war keine ehrliche Suche nach Wahrheit, sondern:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>emotional, auf Stammesstolz (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Nasab</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>) ausgerichtet,</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>und sollte den Propheten in eine defensive oder arrogante Position zwingen.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet reagierte nicht darauf aus Weisheit.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Wie würden wir, besonders unsere Jugendlichen, darauf reagieren?</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Wie reagieren wir, wenn </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>jmd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> in der Öffentlichkeit (sauer) fragt: </a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Eure Frauen haben ja keine Rechte, oder?“ </a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Die </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Schariah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> steht für euch über dem Grundgesetz, richtig?“</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3405266159"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>