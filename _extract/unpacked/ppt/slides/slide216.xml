<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{11BCCCD6-352F-DF6B-3F35-B5467093D0D5}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hamzah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Abdulmuttalib</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>r.a</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. (2)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A2E935A2-7FDF-64F4-910D-BC4571D3EF52}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1103312" y="1807030"/><a:ext cx="9776959" cy="4653642"/></a:xfrm></p:spPr><p:txBody><a:bodyPr><a:normAutofit fontScale="92500"/></a:bodyPr><a:lstStyle/><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Einige Frauen der Banu Hashim fühlten sich sehr verletzt (auch weil ihre Vorfahren beleidigt wurden).  </a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als Hamza zurück kam von seiner Jagd, sprachen die Frauen in der Öffentlichkeit zu Hamza: </a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Was für ein Mann bist du, dass du das zulässt und deinen Neffen nicht verteidigst.“</a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hamza wurde sehr wütend und ging umgehend zur Kaaba mit seiner noch ausgerüsteten Jagdausrüstung</a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er schlug damit Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> ins Gesicht, sodass dieser anfing zu bluten. </a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hamza sagte zu Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>: „Beleidigst du ihn, während ich auf seiner Religion bin?“ </a:t></a:r></a:p><a:p><a:pPr lvl="2" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> war am sitzen, Hamza am stehen. </a:t></a:r></a:p><a:p><a:pPr lvl="2" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Banu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Makhzum</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> wollten Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> zur Hilfe kommen, doch er sagte zu ihnen, sie sollen Hamza lassen.</a:t></a:r></a:p><a:p><a:pPr lvl="2" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Aussage zur Religion war nicht geplant (emotional).</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst>