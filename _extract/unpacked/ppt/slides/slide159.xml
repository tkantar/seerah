<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A43399F8-8D2B-9CD4-54F3-4F938CCDD414}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Juden in Madina &amp; </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Surah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Kahf</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> (4)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F4AB962C-EDCD-2C94-AF6D-F089532A34E4}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1103312" y="1489494"/><a:ext cx="8946541" cy="4825042"/></a:xfrm></p:spPr><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Geschichte zur </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ashabul</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Kahf</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> (zusammengefasst)</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Eine Gruppe gläubiger junger Männer lebte unter einem Götzendiener Volk. Als sie wegen ihres Glaubens verfolgt wurden, zogen sie sich in eine Höhle zurück und baten Allah um Schutz.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Allah ließ sie in einen tiefen Schlaf fallen, der viele Jahre dauerte.</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als sie aufwachten, dachten sie, sie hätten nur einen Tag oder einen Teil eines Tages geschlafen.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als sie in die Stadt gingen, merkten sie:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>die Menschen hatten sich verändert, ihr Geld war veraltet, </a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>der Glaube an Allah war inzwischen bekannt.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Allah hatte sie zu einem Zeichen gemacht:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>dass Er Macht über Zeit, Leben und Auferweckung hat.</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="4033771514"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>