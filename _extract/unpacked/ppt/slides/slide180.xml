p><a:p><a:pPr marL="457200" lvl="1" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="de-DE" b="1" dirty="0"/><a:t>Stirnlocken, die sich vergehen und verstellen!</a:t></a:r></a:p><a:p><a:pPr marL="457200" lvl="1" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="de-DE" b="1" dirty="0"/><a:t>Rufe er doch seine Gesellen!</a:t></a:r></a:p><a:p><a:pPr marL="457200" lvl="1" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="de-DE" b="1" dirty="0"/><a:t>Wir werden die Höllenwächter bestellen!</a:t></a:r></a:p><a:p><a:pPr marL="457200" lvl="1" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="de-DE" b="1" dirty="0"/><a:t>Nein, gehorch ihm nicht! Wirf dich nieder und nahe dich!</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="819240268"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>