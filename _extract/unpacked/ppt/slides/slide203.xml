<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{9481D680-A32C-C62B-4EE0-B4867070EB81}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Ankunft der ersten Auswanderer in Mekka</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{378891E5-56CF-03C4-7254-E1AF4DC2144B}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als die Auswanderer auf wem Rückweg waren, realisierten sie kurz vor Mekka, dass die Gerüchte nicht stimmten. </a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Sie diskutierten, ob sie in Mekka reingehen oder zurück kehren. Sie entschieden, nach Mekka reinzugehen.</a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Uthman bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mazum</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> nahm den Schutz von Walid bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mughira</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Schutz. Uthman bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Mazoum</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> und der beste Dichter Geschichte.</a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu Salama (Cousin des Propheten mütterlicherseits) akzeptierte den Schutz von Abu Talib. </a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> akzeptierte es nicht (weil Banu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Makhzum</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, also Stamm von Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>). </a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2891015305"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>