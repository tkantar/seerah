<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{8E19C69B-4A7C-0F3C-6A73-29454344E012}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Empfang in Madina</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{0FFD8A7C-C500-509E-6FD0-8A7E56DB9D0C}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Medinenser</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> erwarteten den Propheten und hielten morgens Ausschau nach ihm bis zur Mittagshitze.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als der Prophet mit Abu Bakr ankam, erkannten einige Abu Bakr und hielten ihn für den Propheten.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Erst als Abu Bakr dem Propheten mit seinem Gewand Schatten spendete, erkannten die Menschen, wer </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rasulullah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> war.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Menschen freuten sich sehr über die </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ankuft</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> des Propheten und riefen „</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rasulullah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> ist da!“. Die Anwohner strömten aus ihren Häusern.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3285987534"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>