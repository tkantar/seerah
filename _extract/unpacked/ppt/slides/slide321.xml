e-DE" dirty="0"/><a:t>Bald werde ein Prophet kommen.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Sie würden ihm folgen.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Dann würden sie gegen die Götzendiener siegen.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Als einige Männer aus </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Yathrib</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> den Propheten in Mekka hörten, erinnerten sie sich daran. Sie wollten dem Propheten folgen und damit vor den Juden handeln.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2091889539"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>