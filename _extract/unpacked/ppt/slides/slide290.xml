<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{133B9F40-2B41-4E34-C993-611989BCDCB9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Begegnung mit Allah (4)</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die drei Gaben</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{78035198-90C6-5CDA-0E16-E20E280203A3}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>In </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Muslim wird von Ibn Masʿud überliefert:</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Dem Gesandten Allahs wurden drei Dinge gegeben:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>(1) die fünf Gebete,</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>(2) die Schlussverse von al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Baqarah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> (2 Verse),</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>(3) und es wurde seiner </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ummah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> verheißen, dass demjenigen, der Allah nichts beigesellt, die großen Sünden vergeben werden.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith (Bukhari): „Wer die zwei letzten Verse von al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Baqarah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> in der Nacht rezitiert, dem genügen sie.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>(Die Story mit </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Tahiyyat</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bei Miraj hat keine Grundlage in Hadithen oder frühen Seerah-Werken)</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="522079748"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>