<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A3B358BA-2284-C0A0-5658-969918C5FBF8}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die erste Offenbarung (9)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{67166E54-0473-3220-739B-3014B6754DA8}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die wahren Träume fingen ungefähr 6 Monate lang (also Beginn ungefähr </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rabiul</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>awwal</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>).</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die erste Offenbarung war an einem Montag in den letzten 10 Nächten von Ramadan (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Laylatul-Qadr</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>) im Jahre 610.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Offenbarungen waren sehr anstrengend für den Propheten, sehr Energie beraubend.</a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Iqra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> hat zwei Bedeutungen: lesen von einer Seite, lies von deiner </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Errinerung</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.</a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet dachte, Jibril meinte das erste. Gemeint war aber das Zweite.</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3011973017"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>