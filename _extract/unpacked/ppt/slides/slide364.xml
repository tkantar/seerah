<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{4A2C8360-CEC8-859D-DEAE-02429EC1AE15}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Umar </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Khattabs</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijrah</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{E57BF9F5-19EB-1D37-F6F9-7D2EA824FFC5}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Umar gürtete sein Schwert um, hängte sich seinen Bogen um, </a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>nahm seine Pfeile in die Hand und ging zur </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Kaʿba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Dort saßen die Anführer </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Qurayshs</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> in ihren Versammlungsringen. </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ʿUmar</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> machte siebenmal </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ṭawāf</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, betete zwei </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rakʿa</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> am </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Maqām</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ibrāhīm</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> und ging dann zu den einzelnen Gruppen </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Qurayshs</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Dann sagte er: „Wer möchte, dass seine Mutter ihn verliert, sein Kind zur Waise wird und seine Frau zur Witwe wird, der soll mich hinter diesem Tal treffen.“</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3877129013"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>