<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{DC75755C-1D10-B333-BEBA-FD4EAB09D192}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Ankunft des Propheten in </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quba</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{D43FCB38-715A-34EA-646F-A3D47B4613CA}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit lnSpcReduction="10000"/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet erreichte </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, den südlichen Vorort von Madina, wahrscheinlich am 12. Rabiul Awwal.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der genaue Zeitpunkt ist wie so oft umstritten. Manche sagen 8. oder 10. Rabiul Awwal.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Jedenfalls erfolgte die Ankunft an einem Montag zur Mittagszeit.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Jeden Morgen schauten die Menschen, ob der Prophet kam bis zur Mittagshitze, dann zogen sie sich zurück.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rasulullah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> blieb nach </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Bukhari 2 Woche in </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, nach </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>hisham</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> von Montag bis Freitag.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er blieb während seiner Zeit in </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bei Kulthum </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>hidim</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. Dieser war später der erste Tote Muslim der Ansar von Madina.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Andere Quellen sagen, der Prophet blieb bei </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Haythama</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst>