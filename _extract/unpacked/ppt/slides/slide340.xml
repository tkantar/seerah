<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{48452148-761E-F45B-7968-7B8F9ECA1B28}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Sa´d </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Muaz</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{F57F7318-553E-214A-C065-1FEB8D13B2CD}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1103312" y="1736272"/><a:ext cx="10141631" cy="4512128"/></a:xfrm></p:spPr><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Usayd kehrte verändert zurück.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> merkte sofort: Usayd kommt anders zurück, als er gegangen ist.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> wurde selbst wütend und ging zu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Muṣʿab</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> und </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Asʿad</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Auch er kam mit Vorwürfen.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Musab sagte ihm ähnlich: Setz dich. Hör zu. Wenn es dir gefällt, nimm es an. Wenn nicht, lassen wir dich.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> hörte zu. </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Muṣʿab</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> erklärte den Islam und rezitierte </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Qurʾān</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> nahm ebenfalls den Islam an.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Durch die beiden wurden viele Muslime in </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Yathrib</a:t></a:r><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Bedeutung von Sa´d: Der Prophet sagte nach seinem Tod: </a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Der Thron des Allerbarmers erzitterte wegen des Todes von </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Muʿādh</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.“</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="696571404"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>