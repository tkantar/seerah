<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{11E20643-570B-8AF9-2A46-3A56F03528F1}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Gesegnete Moschee</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{57198819-3ECE-4959-42CF-965DF55CF390}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abū </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Saʿīd</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> al-</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ḫudrī</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> berichtet, dass der Prophet gefragt wurde:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Welche der beiden Moscheen wurde auf </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Taqwā</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> gegründet?“</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet nahm Steinchen, warf sie auf den Boden und sagte:</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>هُوَ</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>مَسْجِدُكُمْ</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>هَذَا</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Es ist diese eure Moschee.“</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Gemeint war die Prophetenmoschee in Medina (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Muslim)</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abū </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Huraira</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> überliefert (Tirmizi):</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„Dieser Vers wurde über die Leute von </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quba</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> offenbart: ‚In ihr sind Männer, die es lieben, sich zu reinigen.‘ Sie pflegten sich beim </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Istinja</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> mit Wasser zu reinigen.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Widerspruch, welche Moschee gemeint ist. Eventuell kann man es zusammenführen, indem man sagt: Beide sind gemeint.</a:t></a:r></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p><a:p><a:endParaRPr lang="de-DE" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2310329239"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>