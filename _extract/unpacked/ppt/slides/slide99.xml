<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{CB1F4B37-B850-6CB9-79BC-E3A7449D5EAF}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abdullah bin Masud </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{31607740-C41A-EC3D-3C37-E9BA30F0810F}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1103312" y="1598762"/><a:ext cx="8946541" cy="4649637"/></a:xfrm></p:spPr><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Er war der nächste Konvertit. </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Besonderheiten: </a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Nicht wie die Konvertiten vorher von den noblen </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quraisch</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, sondern jemenitischer Abstammung.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>War Schafhirte aus der Unterschicht.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Kleiner, schmächtiger Mann – gesellschaftlich ohne Schutz.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Später: Einer der größten </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quran</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>-Gelehrten</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Ich habe über 70 Suren direkt aus dem Mund des Gesandten Allahs gelernt. (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Bukhari</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>)</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>hasan</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>, </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>maja</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>): Wer den </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Quran</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> so lesen möchte, wie er offenbart wurde, der soll ihn lesen, wie Ibn Masud ihn liest.“</a:t></a:r></a:p><a:p><a:pPr lvl="2"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith (Ahmad): „Bei Allah, sie sind auf der Waage schwerer als der Berg </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Uhud</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.“</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2150064349"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/>