<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{C7E45B9E-D795-7A7A-5E93-4647371E86AD}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Boykott (3)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{26F06878-55A7-918B-561D-596C014FE957}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Manchmal gingen sie in die Stadt und versuchten von Fremden was zu bekommen. </a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahl</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> griff ein und bot den Leute an, das Doppelte zu zahlen, wenn sie nicht an die Boykottierten verkaufen würden.</a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet machte in der Hajj Zeit weiterhin Dawa in Mekka.</a:t></a:r></a:p><a:p><a:pPr fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet machte Dua (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Bukhari</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>):</a:t></a:r><a:br><a:rPr lang="de-DE" dirty="0"/></a:br><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>„O Allah, unterstütze mich gegen sie mit Jahren wie die Jahre von Yusuf“</a:t></a:r></a:p><a:p><a:pPr lvl="1" fontAlgn="ctr"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Daraufhin traf Mekka eine Hungersnot, sodass einige sogar Leder und Knochen essen mussten.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3628657975"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>