p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Zubair bin </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Awwam</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> ging sogar als Beobachter mit und beobachtete die Situation und kam zurück und verkündete dass Negus gewann. </a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="554319639"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>