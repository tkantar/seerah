="de-DE" dirty="0" err="1"/><a:t>Ma´bad</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> ins Zelt und wunderte sich, woher das Milch stammt.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Umm </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ma´bad</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sagte: „Bei Allah, ein gesegneter Mann kam bei uns vorbei.“</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Daraufhin bat Abu </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ma´bad</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sie um eine Beschreibung, welche Sierah-technisch berühmt geworden ist:</a:t></a:r></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="4" name="Grafik 3" descr="Füttern Baby Schaf Mit Milch Aus Der Flasche Gefüttert. Lizenzfreie Fotos,  Bilder und Stock Fotografie. Image 59856297."><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{99D58FD7-05D4-3331-79AE-D990777C132A}"/></a:ext></a:extLst></p:cNvPr><p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId2"/><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr><a:xfrm><a:off x="9412128" y="1"/><a:ext cx="2779872" cy="1853248"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr></p:pic></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2327834846"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>