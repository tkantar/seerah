DE" dirty="0" err="1"/><a:t>Hāniʾ</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Qabīṣa</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sagte sinngemäß: „Wir haben deine Worte gehört. Es wäre übereilt, nach nur einer Sitzung unsere Religion zu verlassen. Wir müssen nachdenken und beraten.“</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="1577367963"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>