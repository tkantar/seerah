<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{C15BB0F6-35A2-817F-B58F-378F422D43D1}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Zeit bei </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Abdulmuttalib</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> &amp; Abu Talib</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{9F18D674-FDE0-0ADA-403C-0AE5B4610E72}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>2 Jahre blieb </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rasulullah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> bei </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Abdulmuttalib</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> und hatte eine Sonderstellung bei ihm (durfte auf seinen Thron).</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Nach dem Tod </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Abdulmuttalibs</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> blieb der Prophet bei seinem Onkel Abu Talib. Dieser war arm aber hatte einen guten </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Akhlaq</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. </a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Seine Frau hieß Fatima </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>binti</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Aswad</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>. Als diese starb, benutzte </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Rasulullah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sein eigenes Hemd als Leichentuch.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Der Prophet war ab seinem 10. Lebensjahr Hirte und verdiente etwas Geld zum Haushalt.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Hadith (</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Sahih</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Bukhari</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>): Allah hat keinen Propheten gesandt, ohne dass er Schafe gehütet hätte.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="698138907"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>