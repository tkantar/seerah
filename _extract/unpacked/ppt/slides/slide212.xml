<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Titel 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{D5CDB129-0307-1BB0-9C53-DF06BECA683E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Weiteres über die abessinischen Muslime</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Inhaltsplatzhalter 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{58518116-FAB0-CA40-FFCB-956F4E343AB6}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Muslime lebten 12 Jahre in Abessinien.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>7 nach </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> sendete der Prophet einen Brief, wo er wollte, dass die Muslime zurück kehren.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Muslime in Abessinien mussten aber nicht an der </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> nach Medina teilnehmen. Lehre daraus:</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Die Muslime, welche verfolgt wurden und bei der Praktizierung des Islam massive Einschnitte erleiden mussten, waren verpflichtet zur </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>.</a:t></a:r></a:p><a:p><a:pPr lvl="1"/><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Für die Muslime, welche im christlichen Abessinien ihre Religion frei ausleben konnten, existierte diese Pflicht zur </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Hijra</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> nicht.</a:t></a:r></a:p><a:p><a:r><a:rPr lang="de-DE" dirty="0"/><a:t>Eventuell wurde </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Ubaydullah</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>ibn</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Jahsh</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> dort Christ (Mann von </a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0" err="1"/><a:t>Umm</a:t></a:r><a:r><a:rPr lang="de-DE" dirty="0"/><a:t> Habiba).</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3427119516"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>